{
  "name": "atreus",
  "version": "0.1.0",
  "description": "Launcher personal: logros de Steam, trainers y gestor de mods",
  "private": true,
  "author": "Syax",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "cross-env VITE_MOCK=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.3.9",
    "koffi": "^2.10.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.11.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "us.syax.atreus",
    "productName": "Atreus",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/7zip-bin/**"
    ]
  }
}
