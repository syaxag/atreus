{
  "name": "atreus",
  "version": "0.1.1",
  "description": "Cazador de platinos: progreso de logros, guías con texto completo y mapas interactivos de tus juegos",
  "private": true,
  "author": "Syax",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "cross-env VITE_MOCK=1 electron-vite dev",
    "test": "node --test --experimental-strip-types --import ./test/resolver.mjs \"test/*.test.ts\"",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "icon": "node scripts/make-icon.mjs",
    "build": "npm run typecheck && npm test && electron-vite build",
    "pack": "npm run build && electron-builder --dir",
    "release:manifest": "node scripts/make-latest-yml.mjs",
    "dist": "npm run build && electron-builder --win nsis && npm run release:manifest"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.3.9",
    "koffi": "^2.10.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
