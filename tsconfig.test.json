{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "noEmit": true,
    /*
     * Sin `composite`: heredado de la configuración del main obligaría a
     * listar cada archivo que un test alcanza, y lo que se quiere es
     * justamente que TypeScript siga los imports por su cuenta.
     */
    "composite": false,
    /*
     * Los tests importan `../src/algo.ts` con la extensión puesta, porque es
     * lo que Node necesita para cargarlos sin un empaquetador delante. En el
     * código de la aplicación no se hace: ahí resuelven Vite y el compilador.
     */
    "allowImportingTsExtensions": true,
    /*
     * Con DOM: los tests de vistas pintan componentes contra jsdom, así que
     * ven `window`, `document` y `HTMLElement` como los ve el renderer.
     */
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /** Los tests de vistas importan `.tsx`, igual que el renderer. */
    "jsx": "react-jsx",
    "types": ["node", "jsdom"],
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@/*": ["src/renderer/*"]
    }
  },
  /*
   * Solo los tests: de ahí TypeScript sigue los imports y comprueba lo que de
   * verdad se usa. Meter `src/**` entero traería el renderer sin su
   * configuración y mil cuatrocientos errores que no son de nadie.
   */
  "include": ["test/**/*", "src/renderer/env.d.ts"]
}
