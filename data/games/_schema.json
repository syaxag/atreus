{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Definición de juego de Atreus",
  "description": "Un archivo por juego en data/games/. Añadir un juego = añadir un JSON. No hace falta recompilar la app.",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(steam|epic|gog|xbox|ea|battlenet|manual):[A-Za-z0-9._-]+$",
      "description": "Identificador con prefijo de plataforma. Ej: steam:2379780"
    },
    "name": {
      "type": "string"
    },
    "exe": {
      "type": "string",
      "description": "Nombre del ejecutable, para reconocer cuándo el juego está abierto y contar el tiempo de sesión. Ej: Balatro.exe"
    },
    "multiplayer": {
      "type": "boolean",
      "default": false,
      "description": "Solo informativo: Atreus lo enseña en la biblioteca. No bloquea nada."
    },
    "achievements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "steam",
            "none"
          ],
          "default": "steam"
        }
      }
    },
    "mods": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "description": "Subcarpeta del juego donde se despliegan los mods. Ej: Mods"
        },
        "loader": {
          "type": "string",
          "description": "Cargador esperado. Ej: lovely, bepinex, fomod, none"
        },
        "packaged": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extensiones que se despliegan sin extraer, tal cual. Ej: [\".geode\"] para Geode, [\".pak\"] para Unreal."
        },
        "provider": {
          "description": "Catalogos publicos de los que sacar los mods. Uno o varios.",
          "oneOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "community"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "thunderstore"
                    },
                    "community": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "geode"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "workshop"
                    },
                    "appId": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "game"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "modrinth"
                    },
                    "game": {
                      "const": "minecraft"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "gameId"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "const": "gamebanana"
                    },
                    "gameId": {
                      "type": "integer",
                      "description": "Id numerico del juego en GameBanana"
                    }
                  }
                }
              ]
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "community"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "thunderstore"
                      },
                      "community": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "geode"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "workshop"
                      },
                      "appId": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "game"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "modrinth"
                      },
                      "game": {
                        "const": "minecraft"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind",
                      "gameId"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "gamebanana"
                      },
                      "gameId": {
                        "type": "integer",
                        "description": "Id numerico del juego en GameBanana"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "guides": {
      "type": "object",
      "additionalProperties": false,
      "description": "Contenido de guía propio del catálogo.",
      "properties": {
        "maps": {
          "type": "array",
          "description": "Mapas interactivos declarados a mano. Son direcciones: Atreus abre la web del proveedor en su pestaña integrada. Solo hacen falta cuando MapGenie no cubre el juego o hay un mapa mejor.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              },
              "provider": {
                "type": "string",
                "description": "Nombre legible de quien publica el mapa. Ej: MapGenie"
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
